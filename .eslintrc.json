{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "rules": {
    "no-undef": "error",
    "react-hooks/rules-of-hooks": "error"
  },
  "plugins": [
    "react-hooks"
  ]
}
