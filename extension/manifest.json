{
  "manifest_version": 3,
  "name": "NexControl — Captura de Depósitos",
  "version": "1.1.0",
  "description": "Lê o valor dos QR PIX nas abas e envia os depósitos automaticamente pro NexControl.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://nexcpa.com.br/*",
    "https://xtxusfvfrawjhmbhgbds.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NexControl — Captura"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
